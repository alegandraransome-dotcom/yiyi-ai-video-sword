{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yi-director.example/schemas/yi-turn-handoff-v1.json",
  "title": "以一轮次接力",
  "type": "object",
  "required": ["POSITION", "STATE", "LOCKS", "PROTECTED", "NEXT", "REREAD"],
  "properties": {
    "POSITION": {
      "description": "当前剧情与制作位置。",
      "oneOf": [{"type": "string"}, {"type": "object"}]
    },
    "STATE": {
      "description": "当前有效状态；不得用基础资产覆盖。",
      "type": "object"
    },
    "LOCKS": {
      "type": "array",
      "items": {"type": ["string", "object"]}
    },
    "PROTECTED": {
      "type": "array",
      "items": {"type": ["string", "object"]}
    },
    "NEXT": {"type": "string"},
    "REREAD": {
      "type": "array",
      "items": {"type": ["string", "object"]}
    },
    "REREAD_DEBT": {
      "type": "array",
      "items": {"type": ["string", "object"]},
      "default": []
    }
  },
  "additionalProperties": false
}
